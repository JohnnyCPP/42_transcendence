#/**
# * Imagen del frontend (Next.js) servida por HTTPS.
# *
# * Cuatro etapas: dependencias, dependencias de producción, build (que
# * también genera el certificado autofirmado) y ejecución.
# * INTERNAL_API_URL llega como argumento de build porque Next fija los
# * rewrites al compilar. El contenedor arranca con server.mjs.
# */
FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-slim AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:20-slim AS builder
WORKDIR /app
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
ARG INTERNAL_API_URL=http://fastify:3000
ENV INTERNAL_API_URL=$INTERNAL_API_URL \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build
RUN sh scripts/generate-cert.sh /app/certs

FROM node:20-slim AS runner
WORKDIR /app
ARG INTERNAL_API_URL=http://fastify:3000
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOST=0.0.0.0 \
    PORT=3000 \
    INTERNAL_API_URL=$INTERNAL_API_URL \
    HTTPS_CERT_PATH=/app/certs/cert.pem \
    HTTPS_KEY_PATH=/app/certs/key.pem

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/next.config.ts ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/server.mjs ./
COPY --from=builder --chown=node:node /app/certs ./certs

USER node
EXPOSE 3000

CMD ["node", "server.mjs"]
