/*
  schema conventions
  ------------------

  Top-level entities:

    1. Generators     (primary generator first, then auxiliary generators)
    2. Datasource     (exactly one)
    3. Enums          (alphabetical)
    4. Models         (alphabetical)

  Fields within a model:

    1. Identifiers
    2. Business fields
    3. Relations
    4. Audit fields


  Prisma's schema is declarative, not imperative: field order within 
  a model does not affect the generated SQL.

  You can order fields however you like.


  list of enums
  -------------

	- BoardRole
	- GlobalRole
	- OrganizationRole
	- UserStatus


  list of models
  --------------

	- ApiKey
	- Board
	- BoardList
	- BoardMember
	- Card
	- CardAssignee
	- CardLabel
	- Comment
	- Label
	- LoginChallenge
	- Organization
	- OrganizationMember
	- PasswordCredential
	- RecoveryCode
	- Session
	- TwoFactorTotp
	- User
*/


// ------------------------------------------------------------------------- //


generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../document/ERD.svg"
  theme    = "neutral"
  includeRelationFromFields = true
  disabled = false
}


// ------------------------------------------------------------------------- //


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ------------------------------------------------------------------------- //


enum BoardRole {
  admin
  member
  observer
}

enum GlobalRole {
  admin
  moderator
  user
}

enum OrganizationRole {
  admin
  member
  owner
}

enum UserStatus {
  active
  deleted
  disabled
}


// ------------------------------------------------------------------------- //


model ApiKey {

  id          String    @id
  createdById String    @map("created_by_id")

  name        String
  prefix      String    @unique
  hashedKey   String    @unique @map("hashed_key")

  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([createdById])
  @@map("api_keys")
}

model Board {

  // identifiers
  id              String        @id
  organizationId  String        @map("organization_id")
  createdByUserId String        @map("created_by_user_id")

  // business fields
  name            String
  description     String?

  // relations
  lists           BoardList[]
  members         BoardMember[]
  labels          Label[]
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("BoardCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // audit fields
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  archivedAt      DateTime?     @map("archived_at")

  // block attributes
  @@index([organizationId])
  @@map("boards")
}

model BoardList {

  id         String    @id
  boardId    String    @map("board_id")

  name       String
  position   Int

  cards      Card[]
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  // Le dice a la base de datos que la combinacion de boardId y position debe ser unica.
  @@unique([boardId, position])
  @@index([boardId])
  @@map("board_lists")
}

model BoardMember {

  boardId  String    @map("board_id")
  userId   String    @map("user_id")

  role     BoardRole @default(member)

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime  @default(now()) @map("joined_at")

  @@id([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Card {

  id          String         @id
  listId      String         @map("list_id")
  createdById String         @map("created_by_id")

  title       String
  description String?
  position    Int
  dueDate     DateTime?      @map("due_date")

  assignees   CardAssignee[]
  comments    Comment[]
  labels      CardLabel[]
  list        BoardList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("CardCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  archivedAt  DateTime?      @map("archived_at")

  @@unique([listId, position])
  @@index([listId])
  @@index([createdById])
  @@map("cards")
}

model CardAssignee {

  cardId     String   @map("card_id")
  userId     String   @map("user_id")

  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([cardId, userId])
  @@index([userId])
  @@map("card_assignees")
}

model CardLabel {

  cardId  String @map("card_id")
  labelId String @map("label_id")

  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model Comment {

  id        String    @id
  cardId    String    @map("card_id")
  authorId  String    @map("author_id")

  content   String

  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([cardId])
  @@index([authorId])
  @@map("comments")
}

model Label {

  id      String      @id
  boardId String      @map("board_id")

  name    String
  color   String

  cards   CardLabel[]
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, name])
  @@index([boardId])
  @@map("labels")
}

model LoginChallenge {

  id         String    @id
  userId     String    @map("user_id")

  tokenHash  String    @unique @map("challenge_token_hash")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

model Organization {

  id              String               @id
  createdByUserId String               @map("created_by_user_id")

  name            String
  slug            String               @unique

  members         OrganizationMember[]
  boards          Board[]
  createdBy       User                 @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  archivedAt      DateTime?            @map("archived_at")

  @@map("organizations")
}

model OrganizationMember {

  organizationId String       @map("organization_id")
  userId         String       @map("user_id")

  role           OrganizationRole

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       DateTime     @default(now()) @map("joined_at")

  // Al combinar organizationId y userId como una clave primaria compuesta, 
  // le dices a PostgreSQL: "La combinación de estos dos IDs debe ser única 
  // en todo momento". Esto evita duplicados
  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model PasswordCredential {

  userId            String   @id @map("user_id")

  passwordHash      String   @map("password_hash")
  passwordUpdatedAt DateTime @map("password_updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("password_credentials")
}

model RecoveryCode {

  id         String    @id
  userId     String    @map("user_id")

  codeHash   String    @map("code_hash")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now()) @map("created_at")
  usedAt     DateTime? @map("used_at")
  replacedAt DateTime? @map("replaced_at")

  @@index([userId])
  @@map("recovery_codes")
}

model Session {

  id                String    @id
  userId            String    @map("user_id")

  tokenHash         String    @unique @map("session_token_hash")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  reauthenticatedAt DateTime? @map("reauthenticated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  // Sin un indice, PostgreSQL tendria que revisar toda la tabla de sesiones 
  // una por una para encontrar las de ese usuario
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model TwoFactorTotp {

  id              String    @id
  userId          String    @unique @map("user_id")

  secretEncrypted String    @map("secret_encrypted")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabledAt       DateTime? @map("enabled_at")
  confirmedAt     DateTime? @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("two_factor_totp")
}

model User {

  id                   String               @id

  username             String               @unique
  email                String?              @unique
  displayName          String?              @map("display_name")
  role                 GlobalRole           @default(user)
  status               UserStatus           @default(active)
  passwordCredential   PasswordCredential?
  totp                 TwoFactorTotp?

  sessions             Session[]
  loginChallenges      LoginChallenge[]
  recoveryCodes        RecoveryCode[]
  memberships          OrganizationMember[]
  boardMemberships     BoardMember[]
  assignedCards        CardAssignee[]
  comments             Comment[]
  apiKeys              ApiKey[]
  createdOrganizations Organization[]       @relation("OrganizationCreator")
  createdBoards        Board[]              @relation("BoardCreator")
  createdCards         Card[]               @relation("CardCreator")

  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  // le indica a Prisma que traduzca el modelo a la tabla fisica en la base 
  // de datos de PostgreSQL usando minusculas y snake_case, llamandola users
  @@map("users")
}
