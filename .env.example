# Copy to .env. Values below are examples for local development only.
# Compose reads the root file at runtime; backend values also work without Docker.
# Backend runtime: development, test, or production (Docker sets production).
NODE_ENV=development
# Backend runtime: bind address (Docker sets 0.0.0.0).
HOST=127.0.0.1
# Backend runtime: positive TCP port (Docker sets 3000).
PORT=3000
# Backend runtime: true or false (Docker sets true for HTTPS).
COOKIE_SECURE=false
# Backend runtime: session cookie name; default sid.
SESSION_COOKIE_NAME=sid
# Backend runtime: session lifetime in positive whole days; default 14.
SESSION_TTL_DAYS=14
# Backend runtime: label shown by authenticator apps; default Transcendence.
TOTP_ISSUER=Transcendence
# Backend runtime: required outside test; 32 random bytes encoded as Base64.
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-base64
# Backend runtime without Docker: PostgreSQL URL, required outside test.
# Compose builds its own URL from POSTGRES_* and ignores this value.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/transcendence

# Compose/PostgreSQL runtime: database name, default transcendence.
POSTGRES_DB=transcendence
# Compose/PostgreSQL runtime: database user, default postgres.
POSTGRES_USER=postgres
# Compose/PostgreSQL runtime: required password; replace this local example.
# Use URL-safe characters because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=postgres

# Frontend build: INTERNAL_API_URL is set in Compose to http://fastify:3000;
# Next.js embeds rewrites at build time. It is also passed at runtime.
# No NEXT_PUBLIC_* variables are currently used. Any added later are public
# and embedded in browser bundles at build time: pass them as Docker build
# args and rebuild; changing runtime variables alone does not update the bundle.
