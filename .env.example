#/**
# * Plantilla de variables de entorno: cópiala a .env y rellenala.
# *
# * El primer bloque lo usa el backend cuando se arranca sin Docker.
# * Las variables POSTGRES_* las lee docker-compose para crear la base de
# * datos y montar la DATABASE_URL del contenedor fastify.
# * La clave TOTP debe generarse con: openssl rand -base64 32
# */
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=14
TOTP_ISSUER=Transcendence
TOTP_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-base64
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/transcendence

POSTGRES_DB=transcendence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
